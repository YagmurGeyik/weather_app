<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Beyaz splash ekranı — ikon temiz görünür.
        windowLightStatusBar true → status bar ikonları koyu (beyaz üzerinde okunur)
    -->
    <style name="Theme.Hava" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launcher_bg</item>
        <item name="android:statusBarColor">@color/launcher_bg</item>
        <item name="android:navigationBarColor">@color/launcher_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash Screen teması (Android 12+) -->
    <style name="Theme.Hava.Splash" parent="Theme.Hava">
        <item name="android:windowSplashScreenBackground">@color/launcher_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

</resources>